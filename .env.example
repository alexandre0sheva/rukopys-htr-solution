# Copy this file to .env and replace the placeholders with values you control.
# Keep .env private. Do not commit real tokens or personal credentials.

# GitHub publishing target.
REPO_URL=https://github.com/OWNER/REPO.git
GITHUB_REMOTE=https://github.com/OWNER/REPO.git

# Hugging Face publishing target.
HF_NAMESPACE=your-hf-username-or-org
HF_DATASET_ID=your-hf-username-or-org/rukopys-curated-mvp
HF_MODEL_ID=your-hf-username-or-org/rukopys-qwen3-vl-8b-page-qlora

# Optional: leave blank and use `hf auth login` interactively instead.
HF_TOKEN=

# Optional: set true when upload commands should create private Hub repos by default.
HF_PRIVATE=false
